// Источник: devices/virt_suto_s111/s111.tbl
{
  "format": "modbus-regmap/1.0",
  "device": {
    "id": "suto.s111",
    "vendor": "SUTO iTEC",
    "model": "S111",
    "series": "Three-Phase Power Meter",
    "revision": "Rev.2025-2 (S111_Modbus-register-table_EN_V2025-2.pdf)",
    "note": "Источник раздела — таблица производителя; Source: S111_Modbus-register-table_EN_V2025-2.pdf  Rev.2025-2"
  },
  "transport": {
    "protocol": "modbus-rtu",
    "defaults": {
      "address": 1,
      "baud": 9600,
      "parity": "none",
      "stopbits": 1,
      "timeout_ms": 1000,
      "retries": 1
    },
    "limits": {
      "max_regs_per_read": 125,
      "max_regs_per_write": 123
    },
    "byte_order": "ABCD",
    "register_base": 0,
    "functions": {
      "read": 3,
      "write_one": 6,
      "write_many": 16
    }
  },
  "groups": [
    {
      "id": "1.9.1",
      "name": "Equipment parameters",
      "order": 0,
      "registers": [
        {
          "addr": 60,
          "name": "DeviceModel",
          "type": "string",
          "desc": "Device model string",
          "count": 10,
          "access": "R"
        },
        {
          "addr": 70,
          "name": "SerialNo",
          "type": "u32",
          "desc": "Serial number",
          "access": "R"
        },
        {
          "addr": 72,
          "name": "AppVersion",
          "type": "u16",
          "desc": "App version (format X.Y hi-byte.lo-byte)",
          "access": "R"
        },
        {
          "addr": 75,
          "name": "DateTime",
          "type": "time",
          "desc": "Reg75=Year Reg76=Month(b15:8)|Day(b7:0) Reg77=Hour(b15:8)|Min(b7:0) Reg78=Second",
          "count": 4,
          "access": "RW",
          "write": {
            "mode": "command"
          },
          "fields": [
            {
              "name": "Year",
              "addr": 75
            },
            {
              "name": "Month",
              "addr": 76,
              "bits": [
                15,
                8
              ]
            },
            {
              "name": "Day",
              "addr": 76,
              "bits": [
                7,
                0
              ]
            },
            {
              "name": "Hour",
              "addr": 77,
              "bits": [
                15,
                8
              ]
            },
            {
              "name": "Min",
              "addr": 77,
              "bits": [
                7,
                0
              ]
            },
            {
              "name": "Second",
              "addr": 78
            }
          ],
          "poll": "on-demand"
        }
      ]
    },
    {
      "id": "1.9.2",
      "name": "Communication parameters",
      "order": 1,
      "registers": [
        {
          "addr": 80,
          "name": "SlaveAddress",
          "type": "u16",
          "desc": "Slave address 1-247",
          "access": "RW",
          "write": {
            "mode": "command"
          },
          "poll": "on-demand"
        },
        {
          "addr": 81,
          "name": "BaudRate",
          "type": "u16",
          "access": "RW",
          "write": {
            "mode": "command"
          },
          "enum": [
            {
              "v": 0,
              "t": "2400"
            },
            {
              "v": 1,
              "t": "4800"
            },
            {
              "v": 2,
              "t": "9600"
            },
            {
              "v": 3,
              "t": "19200"
            },
            {
              "v": 4,
              "t": "38400"
            },
            {
              "v": 5,
              "t": "57600"
            },
            {
              "v": 6,
              "t": "115200"
            }
          ],
          "poll": "on-demand"
        },
        {
          "addr": 82,
          "name": "Parity",
          "type": "u16",
          "access": "RW",
          "write": {
            "mode": "command"
          },
          "enum": [
            {
              "v": 0,
              "t": "None"
            },
            {
              "v": 1,
              "t": "Odd"
            },
            {
              "v": 2,
              "t": "Even"
            }
          ],
          "poll": "on-demand"
        },
        {
          "addr": 83,
          "name": "StopBit",
          "type": "u16",
          "access": "RW",
          "write": {
            "mode": "command"
          },
          "enum": [
            {
              "v": 0,
              "t": "1bit"
            },
            {
              "v": 1,
              "t": "2bit"
            }
          ],
          "poll": "on-demand"
        }
      ]
    },
    {
