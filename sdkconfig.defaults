CONFIG_HTTPD_WS_SUPPORT=y
# esp_http_server >= v6 answers the WebSocket handshake itself and does not call
# the URI handler for it, so the session is created in ws_post_handshake_cb
# (see main/ws_transport_httpd.c).
CONFIG_HTTPD_WS_POST_HANDSHAKE_CB_SUPPORT=y
# WPA3/SAE is off on purpose: the supplicant plus SAE crypto cost about 63 KB of
# the application partition, which is the tightest resource here. The gateway
# runs WPA2-PSK on its access point and connects to WPA2 networks only. Turn
# these back on only after the app partition has room for them.
# CONFIG_ESP_WIFI_ENABLE_WPA3_SAE is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_H2E is not set
# CONFIG_ESP_WIFI_ENABLE_SAE_PK is not set
# CONFIG_ESP_WIFI_SOFTAP_SAE_SUPPORT is not set
# CONFIG_ESP_WIFI_ENABLE_WPA3_OWE_STA is not set
# Two httpd instances (HTTP file server + dedicated WS server, see
# start_webserver()/start_ws_server() in main/web_server.c) share this single
# global socket pool; the IDF default of 10 is not enough headroom for two
# httpd instances at once.
CONFIG_LWIP_MAX_SOCKETS=48
# Потолок ОДНОВРЕМЕННЫХ TCP-соединений (MEMP_NUM_TCP_PCB). Умолчание 16 — это
# ровно то, из-за чего три открытые вкладки (по шесть keep-alive соединений) уже
# не оставляли места ни новым страницам, ни WebSocket: HTTP и WS делят один
# счётчик. 40 соответствует сумме пулов веб-слоя плюс запас.
CONFIG_LWIP_MAX_ACTIVE_TCP=40
# Пулы веб-слоя (значения по умолчанию те же, что в main/Kconfig.projbuild):
# порт страниц 20 (три вкладки браузера по шесть keep-alive соединений),
# порт WebSocket 10 (он общий для AP и STA), соединений транспорта 10.
# Сумма пулов плюс запас на служебные сокеты обязана влезать в MAX_SOCKETS —
# это проверяется _Static_assert в main/app.c.
CONFIG_WEB_SERVER_MAX_CLIENTS=20
CONFIG_WEB_SOCKET_MAX_CLIENTS=10
CONFIG_WS_TRANSPORT_MAX_CONNS=10
# В эфире 2.4 ГГц потери — норма (соседние сети, свой же softAP на том же
# канале). При минимальном RTO 1,5 с каждый потерянный сегмент останавливает
# окно на полторы секунды, и отдача файла в 0,5 МБ растягивается на десятки
# секунд, хотя мелкие ответы летают. 300 мс — минимальный RTO lwIP.
CONFIG_LWIP_TCP_RTO_TIME=300
# Браузер открывает до 6 соединений на узел за раз. Задача httpd одна на порт и,
# пока отдаёт файл, accept() не зовёт — при очереди 6 часть SYN отбрасывалась, и
# запросы «просто не подключались». 16 — с запасом на страницу из семи файлов.
CONFIG_LWIP_TCP_ACCEPTMBOX_SIZE=16
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
# Оптимизация по размеру: приложение упирается в раздел OTA, а -Og (отладочный
# уровень по умолчанию) даёт образ на 10-20 % больше.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
# Такт ядра — 1 мс (API_WORK_PERIOD_MS в api.h): при 100 Гц по умолчанию
# pdMS_TO_TICKS(1) == 0, задача такта не спит вовсе и душит IDLE0 до watchdog.
CONFIG_FREERTOS_HZ=1000
# На плате стоит флешка Boya: без этого драйвера IDF работает через generic и
# предупреждает в каждой загрузке.
CONFIG_SPI_FLASH_SUPPORT_BOYA_CHIP=y
# Мягкая точка доступа: имя и пароль по умолчанию НЕ задаются — устройство
# генерирует их из MAC (SSID "WG-<три последних байта AP MAC>", пароль — 10
# символов из хеша MAC, см. wifi_ap_credentials_default() в main/nvs_config.c).
# Заданные здесь значения перебивают генерацию.
CONFIG_WIFI_AP_DEFAULT_SSID=""
CONFIG_WIFI_AP_DEFAULT_PASS=""
# Станция по умолчанию выключена (пустой SSID): шлюз поднимает только свою точку
# доступа, а к внешней сети подключается, когда её зададут через wifi.sta.
CONFIG_WIFI_STA_DEFAULT_SSID=""
CONFIG_WIFI_STA_DEFAULT_PASS=""
